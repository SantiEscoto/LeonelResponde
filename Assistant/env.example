# Configuración del Asistente de IA
# Copia este archivo como .env y configura tus valores

# =============================================================================
# CONFIGURACIÓN GENERAL
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# CONFIGURACIÓN DE VOZ (100% GRATUITO)
# =============================================================================
# Calidad de TTS
TTS_QUALITY=high  # high, medium, low
TTS_CACHE_ENABLED=true
TTS_CACHE_SIZE=100

# Configuración de STT
STT_ENGINE=whisper  # whisper, vosk
STT_LANGUAGE=es  # es, en, auto

# Configuración de Vosk (STT offline)
VOSK_MODEL_PATH=./models/voice/vosk-model-es-0.42
VOSK_LANGUAGE=es

# Configuración de Whisper (STT online)
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_LANGUAGE=es

# =============================================================================
# CONFIGURACIÓN DE VISIÓN
# =============================================================================
VISION_ENABLED=true
YOLO_MODEL=yolov8n.pt
OCR_LANGUAGE=spa+eng
OCR_ENGINE=tesseract  # tesseract, easyocr

# Configuración de Tesseract
TESSERACT_CMD=/usr/bin/tesseract

# =============================================================================
# CONFIGURACIÓN DE FINE-TUNING
# =============================================================================
FINETUNING_ENABLED=true
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.1

# Configuración de QLoRA
QLORA_ENABLED=true
QLORA_BITS=4
QLORA_DOUBLE_QUANT=True

# =============================================================================
# CONFIGURACIÓN SOCIAL
# =============================================================================
SOCIAL_AI_ENABLED=true
MAX_CONCURRENT_USERS=6
ATTENTION_TIMEOUT=300  # 5 minutos

# Configuración de relaciones
RELATIONSHIP_LEARNING_RATE=0.01
PRIORITY_BOOST_FACTOR=1.5

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================
DATABASE_URL=sqlite:///./assistant.db
REDIS_URL=redis://localhost:6379

# =============================================================================
# CONFIGURACIÓN DE MONITOREO
# =============================================================================
MONITORING_ENABLED=true
ALERT_EMAIL=admin@example.com
ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=587

# =============================================================================
# CONFIGURACIÓN DE HARDWARE
# =============================================================================
# Detección automática de hardware
AUTO_DETECT_HARDWARE=true

# Configuración manual (si auto_detect=false)
HARDWARE_TYPE=auto  # auto, jetson_nano, raspberry_pi, desktop
MAX_MEMORY_GB=8
MAX_CPU_CORES=4
HAS_GPU=false

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

